# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key (Project Settings → API → anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of emails allowed to sign in via magic link.
# Enforced in middleware.ts; anyone else is signed out and redirected to /login.
ALLOWED_EMAILS=ethan@example.com,bryce@example.com
